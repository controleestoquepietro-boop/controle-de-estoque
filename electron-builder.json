{
  "build": {
    "appId": "com.controle-estoque.app",
    "productName": "Controle de Estoque",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist/server/**/*"
    ],
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Controle de Estoque"
    }
  }
}
